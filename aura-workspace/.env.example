# --- AURA v0.2-cloud config ---
# Copy to .env.local (never committed). Same values on home PC and Vercel,
# except NEXT_PUBLIC_CLOUD and AURA_VAULT (see below).

# Shared cloud database (Supabase). Server-side only — never NEXT_PUBLIC.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Links the Vercel app to YOUR home PC. Generated by `npm run agent:setup`.
# Must match on both ends. Rotate by re-running setup + updating Vercel.
AGENT_SECRET=
# Your numeric aura_users id. Written by `npm run agent:setup`. Home PC only.
AURA_USER_ID=

# Vault root: the ONLY folder the web can see. Keep it small on the i3.
# Home PC:  AURA_VAULT=./vault   (or F:/AURA_Vault)
# Vercel:    AURA_VAULT=/tmp/aura-vault  (ephemeral; real files come via tunnel)
AURA_VAULT=./vault
# Session lifetime (hours). Kill-switch revokes all immediately.
AURA_SESSION_HOURS=12
# Max upload size (MB)
AURA_MAX_UPLOAD_MB=100
# Max files listed per folder
AURA_MAX_LIST=500

# --- Vercel-only ---
# NEXT_PUBLIC_CLOUD=1   (routes file traffic through /api/remote → home tunnel)
# AURA_VAULT=/tmp/aura-vault
